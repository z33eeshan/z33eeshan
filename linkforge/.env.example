# ---------------------------------------------------------------------------
# LinkForge configuration. Copy to `.env.local` and fill in what you have.
# The app runs with NONE of these set — every integration degrades gracefully
# and the UI tells you which key unlocks which feature.
# ---------------------------------------------------------------------------

# The site you are building links for.
TARGET_SITE=livenewsof.com

# Brand names to watch for unlinked mentions, comma separated.
BRAND_TERMS=livenewsof,Live News Of

# Competitors to run link-gap analysis against, comma separated.
COMPETITORS=

# --- Storage ---------------------------------------------------------------
# SQLite file. Relative paths resolve from the project root.
DATABASE_PATH=./data/linkforge.db

# --- Crawler behaviour -----------------------------------------------------
# Identify yourself honestly. Site owners block anonymous crawlers, and a
# reachable contact URL is the difference between being allowed and being
# firewalled.
CRAWLER_USER_AGENT=LinkForgeBot/0.1 (+https://livenewsof.com/bot)
# Minimum delay between requests to the SAME host, milliseconds.
CRAWLER_HOST_DELAY_MS=1500
# Max concurrent requests across all hosts.
CRAWLER_CONCURRENCY=5
# Hard cap on response body size, bytes. Protects against huge pages.
CRAWLER_MAX_BYTES=3000000

# --- Google Search Console (free, authoritative for YOUR OWN backlinks) ----
# Create an OAuth 2.0 Web client at https://console.cloud.google.com/apis/credentials
# Enable the "Google Search Console API". Add the redirect URI below verbatim.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Random string used to sign the local session cookie.
# Generate with: openssl rand -hex 32
SESSION_SECRET=

# --- Free authority metric (Common Crawl domain ranks) ---------------------
# No key needed. Run `npm run ranks:import` once to download and index the
# host-level ranks file. See README for the size/time tradeoff.
DOMAIN_RANKS_URL=

# --- Optional: OpenPageRank (free key, 1000 domains/day) ------------------
# https://www.domcop.com/openpagerank/ - free API key, no card.
OPENPAGERANK_API_KEY=

# --- Optional: SERP provider for unlinked-mention discovery ---------------
# Brave Search API has a genuinely free tier (no card for the free plan).
# https://brave.com/search/api/
# Leave empty to use the manual-import fallback (paste SERP results in the UI).
SERP_PROVIDER=none
BRAVE_SEARCH_API_KEY=

# --- Optional: paid backlink index --------------------------------------
# The provider interface is pluggable. Set these later if you buy credits and
# the opportunity finder gains full competitor backlink data.
# DATAFORSEO_LOGIN=
# DATAFORSEO_PASSWORD=
